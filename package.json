{
  "name": "registerdesk",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "profile:builder": "node -e \"process.stdout.write(require('fs').readFileSync('scripts/profiling/event-builder-profiler.js','utf8'))\"",
    "profile:build": "next build --profile",
    "profile:serve": "next start",
    "profile:auth": "playwright test --project=setup",
    "profile:run": "playwright test --project=profile",
    "profile:compare": "node scripts/profiling/compare-baselines.mjs",
    "emu:start": "npx --yes firebase-tools emulators:start --project demo-registerdesk --only auth,firestore,storage",
    "emu:seed": "dotenv -e .env.emulator -- node scripts/emulator/seed.mjs",
    "emu:dev": "dotenv -e .env.emulator -- next dev -p 3187",
    "emu:build": "dotenv -e .env.emulator -- next build --profile",
    "emu:serve": "dotenv -e .env.emulator -- next start -p 3187",
    "emu:profile": "npm run emu:seed && dotenv -e .env.emulator -- playwright test",
    "seed:demo": "npx tsx scripts/seed-demo-events.ts",
    "deploy:firebase": "firebase deploy --only firestore:rules,firestore:indexes,storage",
    "emu:shots": "npm run emu:seed && dotenv -e .env.emulator -- node scripts/profiling/capture-ux.mjs",
    "test:emu": "dotenv -e .env.emulator -- vitest run tests/emulator --no-file-parallelism --exclude tests/emulator/creditLoad.emu.test.ts --exclude tests/emulator/creditMixedLoad.emu.test.ts --exclude tests/emulator/multiInstance.emu.test.ts",
    "test:emu:load": "dotenv -e .env.emulator -- vitest run tests/emulator/creditLoad.emu.test.ts tests/emulator/creditMixedLoad.emu.test.ts --no-file-parallelism",
    "test:emu:multi": "bash scripts/loadtest/multiInstance.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@aws-sdk/client-sesv2": "^3.1079.0",
    "@aws-sdk/s3-request-presigner": "^3.1095.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@sentry/node": "^10.59.0",
    "@types/qrcode": "^1.5.6",
    "@zxing/browser": "^0.2.0",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "firebase": "^12.14.0",
    "firebase-admin": "^13.10.0",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-easy-crop": "^5.5.7",
    "react-icons": "^5.6.0",
    "read-excel-file": "^9.1.1",
    "swiper": "^12.2.0",
    "tailwind-merge": "^3.6.0",
    "undici": "^7.28.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
