rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Admin-SDK-only collections ─────────────────────────────────────────────
    // These are written and read exclusively through server-side API routes using
    // the Firebase Admin SDK.  Explicit deny prevents accidental client access if
    // a future developer adds a client-side read without checking the rules.
    match /registrations/{docId} {
      allow read, write: if false;
      // Per-registration audit log (server-only, written via the Admin SDK).
      // Firestore rules do NOT cascade to subcollections, so this needs its own
      // explicit deny — otherwise it would rely on implicit default-deny alone
      // (EA-3 S3 hardening; closes EA-1 L-3).
      match /auditLog/{auditId} {
        allow read, write: if false;
      }
      // RD-CHECKIN-2.0 — the append-only check-in history. Server-only, written
      // via the Admin SDK, and it carries operator identity, so it needs the same
      // explicit deny for the same reason as auditLog above: rules do NOT cascade
      // into subcollections, and relying on implicit default-deny is exactly the
      // gap EA-3 closed here.
      match /checkinHistory/{entryId} {
        allow read, write: if false;
      }
    }
    match /registrationCounters/{docId} {
      allow read, write: if false;
    }
    // WhatsApp Inbox (Phase 1a) — attendee message content. Admin SDK only: every read goes
    // through a server route that enforces organizer ownership or Super Admin, so a client
    // can never select another organizer's conversation by id. Rules do NOT cascade into
    // subcollections, hence the explicit deny on messages as well.
    match /whatsappInbound/{docId} {
      allow read, write: if false;
    }
    match /whatsappConversations/{conversationId} {
      allow read, write: if false;
      match /messages/{messageId} {
        allow read, write: if false;
      }
    }
    // RD-CHECKIN-2.0 — staff account profiles and the username uniqueness locks.
    // Both are written only by lib/staff/service.ts through the Admin SDK. Denied
    // to the client SDK outright: the profile carries a gate operator's event
    // assignment, and the lock collection would otherwise let any signed-in caller
    // enumerate every username on the platform.
    match /staffAccounts/{docId} {
      allow read, write: if false;
    }
    match /staffUsernames/{username} {
      allow read, write: if false;
    }
    match /registrationClaims/{docId} {
      allow read, write: if false;
    }
    match /ticketCodeClaims/{docId} {
      allow read, write: if false;
    }

    // RD-FINANCE-CLOSURE-02 — append-only payout-profile change history. Written
    // ONLY by the payout-profile PUT (in the same batch as the change) and read
    // ONLY through GET /api/organizer/payout-profile/history, both via the Admin
    // SDK. Denying writes here also means a compromised client cannot forge or
    // erase an entry in the trail that exists to detect payout redirection.
    match /payoutProfileHistory/{docId} {
      allow read, write: if false;
    }

    // CRM contacts + activity timeline (derived attendee intelligence, contains
    // PII). Written and read exclusively through server-side API routes via the
    // Admin SDK. Explicit deny prevents accidental client access.
    match /crmContacts/{docId} {
      allow read, write: if false;
    }
    match /crmActivities/{docId} {
      allow read, write: if false;
    }

    // Identifier Engine — authoritative identifier locks, per-pool counters,
    // immutable history, per-event config, and the legacy bib collections. All
    // written and read exclusively through server-side API routes via the Admin
    // SDK. Explicit deny prevents accidental client access.
    match /identifierLocks/{docId} {
      allow read, write: if false;
    }
    match /identifierCounters/{docId} {
      allow read, write: if false;
    }
    match /identifierHistory/{docId} {
      allow read, write: if false;
    }
    match /identifierConfigs/{docId} {
      allow read, write: if false;
    }
    match /bibLocks/{docId} {
      allow read, write: if false;
    }
    match /bibCounters/{docId} {
      allow read, write: if false;
    }
    // RD-EVENT-19F-B — timing tag locks and their import jobs. Tag ids are
    // organizer/provider operational data and are never exposed to a participant,
    // so the client has no read path either.
    match /identifierTagLocks/{docId} {
      allow read, write: if false;
    }
    match /timingTagImportJobs/{docId} {
      allow read, write: if false;
      match /items/{itemId} {
        allow read, write: if false;
      }
    }

    // Published donation campaigns and their counters are written exclusively
    // by POST /api/campaigns/publish (Admin SDK).  Deny direct client writes.
    match /donationCampaigns/{docId} {
      allow read, write: if false;
    }
    match /donationCounters/{docId} {
      allow read, write: if false;
    }

    // ── Financial collections — explicit deny ─────────────────────────────────
    // All financial data is accessed exclusively through server-side API routes
    // via the Firebase Admin SDK, which bypasses these rules entirely.
    // Explicit deny rules ensure no client SDK path (direct reads, realtime
    // listeners, offline cache) can access this data, even if a future developer
    // adds a client-side query without auditing the security model first.
    // Do not remove or relax these rules without a full security review.

    // Platform-level ledger of every payment processed.
    // Written by POST /api/registrations/verify-payment and webhook handlers.
    match /platformTransactions/{docId} {
      allow read, write: if false;
    }

    // Per-organizer revenue wallet: pendingPaise / availablePaise / settledPaise.
    // Written by registration, refund, settlement, and release-funds flows.
    match /organizerRevenueWallets/{docId} {
      allow read, write: if false;
    }

    // Organizer-initiated payout requests reviewed by admin.
    // Written by POST /api/organizer/settlements and PATCH /api/admin/settlements/[id].
    match /settlementRequests/{docId} {
      allow read, write: if false;
    }

    // Audit trail created by the T+2 release engine for every pending→available move.
    // Written by POST /api/admin/finance/release-funds.
    match /settlementReleases/{docId} {
      allow read, write: if false;
    }

    // Immutable audit log of every admin financial action (approve / reject / paid / release).
    // Written by lib/admin/audit.ts; never readable or writable from the client.
    match /adminAuditLogs/{docId} {
      allow read, write: if false;
    }

    // RD-PRICING-01B platform pricing engine singleton — server-only (Admin SDK via
    // GET/PATCH /api/admin/platform-settings). No client SDK access.
    match /platformSettings/{docId} {
      allow read, write: if false;
    }

    // RD-PRODUCT-01C organizer email white-label branding — server-only (Admin SDK via
    // GET/PATCH /api/organizer/email-branding). No client SDK access.
    match /emailBranding/{organizerUid} {
      allow read, write: if false;
    }

    // RD-PRODUCT-01E organization tax profile (GSTIN/PAN/invoice config).
    //
    // RD-FINANCE-TAX-CLEANUP-01 · the GET/PATCH /api/organizer/tax-profile route that used
    // to write this collection has been REMOVED. Organizer GST is not active: nothing in
    // the live pricing, payment, receipt, settlement, refund or report path consumes this
    // profile, and the route accepted configuration that changed nothing. The dormant GST
    // engine (lib/platform/pricing/tax.ts + taxProfile.ts) is retained and still tested.
    //
    // The deny stays: existing documents remain unreadable and unwritable from any client,
    // and no new writer exists. Delete the rule only when the collection itself goes.
    match /taxProfile/{organizerUid} {
      allow read, write: if false;
    }

    // RD-PRODUCT-01F post-publish edit version history — server-only (Admin SDK via
    // /api/organizer/events/[eventId]/edit-history). Rules don't cascade to subcollections,
    // so this needs its own explicit deny alongside the existing changeLog default-deny.
    match /events/{slug}/editHistory/{recordId} {
      allow read, write: if false;
    }

    // Bank account details for organizer payouts.
    // Written by PUT /api/organizer/payout-profile (Admin SDK); read only via API.
    match /organizerPayoutProfiles/{docId} {
      allow read, write: if false;
    }

    // ── Remaining finance-only collections (P9.1) ─────────────────────────────
    // All written/read exclusively through server-side API routes via the Admin
    // SDK (payments, wallets, refunds, clawbacks, comms billing, and the durable
    // financial-reconciliation records). Explicit deny prevents accidental client
    // access to money/PII data.
    match /paymentIntents/{docId}                       { allow read, write: if false; }
    match /paymentEvents/{docId}                        { allow read, write: if false; }
    match /refundWebhookEvents/{docId}                  { allow read, write: if false; }
    match /failedRefunds/{docId}                        { allow read, write: if false; }
    match /suspiciousPayments/{docId}                   { allow read, write: if false; }
    match /donationRefunds/{docId}                      { allow read, write: if false; }
    match /organizerWallets/{docId}                     { allow read, write: if false; }
    match /walletTransactions/{docId}                   { allow read, write: if false; }
    match /walletTopups/{docId}                         { allow read, write: if false; }
    match /walletClawbacks/{docId}                      { allow read, write: if false; }
    match /communicationUsage/{docId}                   { allow read, write: if false; }
    match /organizerLimits/{docId}                      { allow read, write: if false; }
    match /registrationFinancialReconciliation/{docId}  { allow read, write: if false; }
    match /refundLedgerReconciliation/{docId}           { allow read, write: if false; }
    match /walletTopupReconciliation/{docId}            { allow read, write: if false; }
    match /donationFinancialReconciliation/{docId}      { allow read, write: if false; }

    // ── Team, credentials, webhooks & licensing (EA-3 S3) ─────────────────────
    // Server-only collections holding invite tokens, API-key hashes, webhook
    // delivery payloads, and event-license/order records. These were already
    // secured by implicit default-deny (no client SDK path reads them); the
    // explicit denies below make that guarantee consistent with the doctrine
    // above and act as a tripwire against a future client query being added
    // without a security review. No behavioral change — default-deny already
    // blocked all client access.
    match /teamMembers/{docId}        { allow read, write: if false; }
    match /apiKeys/{docId}            { allow read, write: if false; }
    match /webhookDeliveries/{docId}  { allow read, write: if false; }
    match /eventLicenses/{docId}      { allow read, write: if false; }
    match /licenseOrders/{docId}      { allow read, write: if false; }
    match /licenseHistory/{docId}     { allow read, write: if false; }
    // EA-4 S2 — license coupons (admin-managed; validated/redeemed server-side only).
    match /licenseCoupons/{docId}     { allow read, write: if false; }
    // EA-4 S1 — immutable publish-governance baselines (identity snapshot). Written
    // exclusively server-side by the Publish Governance Engine (Admin SDK).
    match /publishBaselines/{docId}   { allow read, write: if false; }

    // ── Race Operations (RD-RACEOPS-01 Sprint 3) ──────────────────────────────
    // Import sessions and their draft/published race results. Written and read
    // exclusively through /api/organizer/race-operations/** via the Admin SDK, which
    // bypasses these rules. Every route authorizes with requireAdmin (workspace owner or
    // an `admin` team member) and re-checks organizerUid on each session, so tenant
    // isolation lives in the route layer; these denies are the tripwire that stops a
    // future client-side query being added without a security review.
    //
    // The `results` subcollection needs its OWN deny: Firestore rules do not cascade to
    // subcollections (same reason registrations/{id}/auditLog has an explicit deny above).
    match /raceImportSessions/{sessionId} {
      allow read, write: if false;

      match /results/{rowId} {
        allow read, write: if false;
      }
    }

    // RD-RACEOPS-01 Sprint 4 — the Official Result Snapshot, the ONLY public read model.
    // Still server-only: the public pages are SERVER components that read via the Admin
    // SDK, so no browser ever queries these collections directly. Keeping the deny means a
    // future client-side query cannot be added without a security review — and it is the
    // reason the snapshot carries no organizerUid/eventId/sessionId in what it returns.
    // The `entries` subcollection needs its own deny; rules do not cascade.
    match /raceResultSnapshots/{snapshotId} {
      allow read, write: if false;

      match /entries/{bibKey} {
        allow read, write: if false;
      }
    }

    // RD-MEDIA-01 — Media Studio. Galleries, albums, photo METADATA and per-workspace
    // upload settings. Image bytes never live here: they are in object storage, reached
    // only through features/platform-storage. Written and read exclusively by
    // /api/organizer/media-studio/** via the Admin SDK, which authorizes every call with
    // the existing `events` permission and re-checks organizerUid on each document.
    match /mediaGalleries/{galleryId} { allow read, write: if false; }
    match /mediaAlbums/{albumId}      { allow read, write: if false; }
    match /mediaAssets/{assetId}      { allow read, write: if false; }
    match /mediaSettings/{organizerUid} { allow read, write: if false; }
    // RD-MEDIA-04 — bulk operation batches (delete / move / publish). Generic lib/jobs
    // Jobs, driven only by /api/cron/media-jobs via the Admin SDK.
    match /mediaJobs/{jobId}          { allow read, write: if false; }

    // MC-01 — Media Credits. Wallet balances, an APPEND-ONLY ledger, upload reservations,
    // purchases and refund requests. Same posture as the Media Studio collections above:
    // no client path exists at all. Every read and write goes through
    // /api/organizer/media-credits/** (organizer, existing `events` permission) or the
    // platform-admin routes, both via the Admin SDK, which re-checks organizerUid.
    //
    // Deny-all is what makes the ledger append-only by construction rather than by
    // convention: there is no client capable of updating an entry.
    match /mediaCreditWallets/{organizerUid}    { allow read, write: if false; }
    match /mediaCreditLedger/{entryId}          { allow read, write: if false; }
    match /mediaCreditReservations/{assetId}    { allow read, write: if false; }
    match /mediaCreditPurchases/{purchaseId}    { allow read, write: if false; }
    match /mediaCreditRefunds/{refundId}        { allow read, write: if false; }
    // MC-04. Captured payments awaiting a grant retry. Server-only like the rest: a client
    // that could read this would learn which organizers are owed credits.
    match /mediaCreditReconciliations/{orderId} { allow read, write: if false; }
    // MC-06A. Upload-session allocations. Server-only like the rest.
    match /mediaCreditSessions/{sessionId}      { allow read, write: if false; }
    // MC-09. Manual grant justifications — who issued credits, to whom, and why. Deny-all is
    // load-bearing twice over: a writable grant record would let a client fabricate the
    // justification for credits it did not receive, and a readable one would expose internal
    // support notes about other organizers.
    match /mediaCreditGrants/{grantId}          { allow read, write: if false; }

    // RD-BADGE-01 — finisher badge METADATA. The PNG bytes live in object storage, reached
    // only through features/platform-storage. Written server-side by the badge service and
    // read by /api/public/badges/** (a SERVER route using the Admin SDK), so no browser ever
    // queries this collection directly. The deny is the tripwire against that changing
    // without a security review.
    match /finisherBadges/{badgeId} { allow read, write: if false; }

    // RD-AI-01 — the AI pipeline. `aiJobs` is queue control (status, attempts, provider,
    // duration); `aiResults` holds normalised model output ABOUT an event's photos; the
    // batch driver in `aiBatches` is a generic lib/jobs Job. All three are written and read
    // exclusively server-side, by the dispatcher and by /api/organizer/ai/** via the Admin
    // SDK, which authorizes every call with the existing `events` permission.
    //
    // An AI result is an inference about a participant. It is organizer working data and is
    // never public — the deny here is the tripwire against a future feature deciding
    // otherwise without a security review, and it is what keeps `visibility` from being the
    // only thing standing between a machine guess and a stranger.
    match /aiJobs/{jobId}       { allow read, write: if false; }
    match /aiResults/{resultId} { allow read, write: if false; }
    match /aiBatches/{batchId}  { allow read, write: if false; }

    // RD-BIB-01 — photo ↔ runner links. A link says "this photograph appears to show bib
    // 137, who ran the 10K": a MACHINE'S UNREVIEWED GUESS about a person, carrying a
    // confidence and a review status that starts `pending`.
    //
    // Denied to every client. The runner gallery that will eventually consume this is a
    // later sprint and will read through a projection built for the purpose — it will not
    // open this collection to the browser. Note what a link does NOT store: no name, no
    // time, no rank. Those stay in the published snapshot and are read from there, so this
    // collection never becomes a second copy of participant data.
    match /photoBibLinks/{linkId} { allow read, write: if false; }

    // RD-DASHBOARD-02 — organizer daily rollups + their coverage markers.
    // Written ONLY inside the registration transactions that already maintain
    // registrationCounters, and read ONLY by the dashboard API. Both use the Admin
    // SDK, which bypasses these rules; an explicit deny keeps a future client-side
    // read from quietly becoming possible.
    match /organizerDailyStats/{docId} { allow read, write: if false; }

    // ── Organizer profile ──────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      // RD-PHASE4-C7 closeout — profile keys written ONLY by trusted server code (Admin SDK):
      // the admin comp/override tier (PATCH /api/admin/organizers/[uid]/plan) and every
      // custom-domain field (lib/domains/service.ts). A client may never supply them.
      function userServerOwnedKeys() {
        return ['entitlementOverrideTier', 'entitlementUpdatedBy', 'entitlementUpdatedAt',
                'customDomain', 'customDomainStatus', 'customDomainSslStatus', 'customDomainToken',
                'customDomainVerifiedAt', 'customDomainError', 'customDomainUpdatedAt',
                // RD-PHASE4 signup transition — validated server-side by lib/branding/service.ts
                // (https-only images, hex colours, sanitised sender name); signup never sends it.
                'branding'];
      }
      // A missing `mobile` map reads as unverified on both sides, so an update that does not
      // touch mobile always passes; a non-map `mobile` errors, and an error denies.
      function userMobileVerificationUnchanged() {
        let before = resource.data.get('mobile', {});
        let after  = request.resource.data.get('mobile', {});
        return after.get('verified', false) == before.get('verified', false)
            && after.get('verifiedAt', null) == before.get('verifiedAt', null);
      }

      // Owner may create their own profile doc (createOrganizerProfile, run once right
      // after Auth signup). Constrained to the canonical initial shape so a client can't
      // forge server-owned identity/moderation/trust fields at create time (RD-AUTH-GA-01;
      // mirrors the update guard below). The Admin SDK (verify-otp self-heal) bypasses
      // rules, so recovery is unaffected.
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.role == 'organizer'
        && request.resource.data.emailVerified == false
        && request.resource.data.verification.email.verified == false
        && request.resource.data.trust.score == 0
        // RD-PHASE4 signup transition — an OLDER app bundle sends no accountStatus; the current
        // one sends 'pending'. Both are accepted; any client-supplied other value ('active',
        // 'suspended', 'banned', …) is refused. verify-otp activates either shape only after a
        // successful OTP. Tighten back to == 'pending' once older bundles are gone.
        && (!('accountStatus' in request.resource.data)
            || request.resource.data.accountStatus == 'pending')
        // RD-PHASE4-C7 closeout · server-owned fields may not be SELF-ASSIGNED at create either
        // (the update deny-list below only covers later writes). No client bundle has ever sent
        // them: createOrganizerProfile writes none of these keys.
        && !request.resource.data.keys().hasAny(userServerOwnedKeys())
        // mobile is optional (older bundles did not send it); when present it must be the
        // unverified initial shape — verification is server-owned (no phone OTP exists yet).
        && (!('mobile' in request.resource.data)
            || (request.resource.data.mobile.get('verified', false) == false
                && request.resource.data.mobile.get('verifiedAt', null) == null));

      // Owner may update their editable profile fields, but NOT server-owned
      // moderation / identity / trust fields. Those are written exclusively by the
      // Admin SDK (which bypasses rules) — e.g. moderation status via
      // setOrganizerAccountStatus, email verification via verify-otp. Without this
      // guard a suspended/banned organizer could self-reactivate by writing
      // accountStatus, or forge emailVerified/trust. Mirrors the eventDrafts /
      // campaignDrafts field-guard pattern below. diff() blocks only actual
      // changes, so re-sending an unchanged value is still allowed.
      allow update: if request.auth != null
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasAny(['role', 'accountStatus', 'statusReason', 'statusUpdatedAt',
                     'statusUpdatedBy', 'emailVerified', 'verification', 'trust',
                     // RD-WORKSPACE-OWNERSHIP-01 · `workspaceOwner` decides which workspace
                     // a caller resolves into (lib/team/workspace.ts), so it is identity,
                     // not preference. Immutable after create: the signup path writes it
                     // once, and the Admin SDK (verify-otp backfill, ensureOrganizerProfile)
                     // bypasses rules. Blocking UPDATE and not CREATE is deliberate — a
                     // create constraint would reject any still-deployed older client bundle
                     // that does not send the field, and the create case is not the risk:
                     // the only workspace a self-asserted owner resolves into is their own.
                     'workspaceOwner',
                     // Server-owned — written ONLY by the branding/domain services via
                     // the Admin SDK. Guarding them stops a client SDK from forging a
                     // 'verified' custom domain (bypassing DNS + plan checks, squatting a
                     // victim's domain) or writing unvalidated / plan-gated branding
                     // directly on its own user doc (RD-ORG-GA-04 F1/F2).
                     'branding', 'customDomain', 'customDomainStatus',
                     'customDomainSslStatus', 'customDomainToken', 'customDomainVerifiedAt',
                     // RD-PHASE4-C7 closeout — also written only by lib/domains/service.ts.
                     'customDomainError', 'customDomainUpdatedAt',
                     // RD-PHASE4-S1 · C7 — the admin comp/override tier and its stamps are written ONLY by
                     // PATCH /api/admin/organizers/[uid]/plan (Admin SDK). A client that could write
                     // them would grant itself a higher workspace entitlement tier.
                     'entitlementOverrideTier', 'entitlementUpdatedBy', 'entitlementUpdatedAt'])
        // RD-PHASE4-C7 closeout · phone verification is server-owned: the client may not flip
        // mobile.verified / mobile.verifiedAt (the rest of `mobile` is untouched by this rule).
        && userMobileVerificationUnchanged();

      // ── Event drafts ──────────────────────────────────────────────────────────
      // Clients may read and update wizard fields freely.
      // Server-controlled fields (status, communicationBilling, publishedAt)
      // are write-protected — only the Admin SDK (API routes) may set them.
      // RD-CE-FIX M2 · an ALLOW-list, not a deny-list. The wizard now saves through
      // /api/organizer/drafts (Admin SDK, same allow-list in lib/events/draftWrite.ts); these rules
      // only bound what a direct client write could still do, and stay compatible with an older
      // client that writes wizard fields directly. A key outside the list — every lifecycle,
      // review, billing, publish and commerce stamp (lifecycleStatus, completedAt, restoredAt,
      // reviewStatus, publishedAt, …) or any unknown key — is refused on create AND update.
      function draftWizardKeys() {
        return ['currentStep', 'completedValues', 'eventType', 'eventSubtype', 'customEventSubtype',
                'campaignType', 'visibility', 'accessControl', 'pricing', 'registrationForm',
                'eventDetails', 'linkedCampaign', 'licenseTier', 'registrationCapacity',
                'serviceSelection', 'updatedAt'];
      }
      function draftSlugOf(d) {
        return d.get('eventDetails', {}).get('seo', {}).get('urlSlug', null);
      }
      match /eventDrafts/{draftId} {
        allow read: if request.auth != null && request.auth.uid == userId;

        // A new draft: wizard keys plus the fixed initial stamps only — it must start as an
        // unpublished, unbilled 'draft'.
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(
               draftWizardKeys().concat(['id', 'status', 'communicationBilling', 'publishedAt', 'createdAt']))
          && request.resource.data.status == 'draft'
          && request.resource.data.get('communicationBilling', null) == null
          && request.resource.data.get('publishedAt', null) == null;

        // Updates touch wizard keys only. Once the draft has produced its live event
        // (`publishedAt` set by the server), its identity is frozen (H5): the public slug and the
        // type / visibility / licence fields belong to the live event and cannot be rewritten here.
        allow update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(draftWizardKeys())
          && (resource.data.get('publishedAt', null) == null
              || (draftSlugOf(request.resource.data) == draftSlugOf(resource.data)
                  && !request.resource.data.diff(resource.data).affectedKeys().hasAny(
                       ['eventType', 'eventSubtype', 'customEventSubtype', 'campaignType',
                        'visibility', 'licenseTier'])));
      }

      // ── Campaign drafts ───────────────────────────────────────────────────────
      // Donation-only campaign wizard writes directly from the client SDK.
      // Server-controlled fields (status, publishedCampaignId, publishedSlug)
      // are write-protected — only POST /api/campaigns/publish (Admin SDK) sets them.
      match /campaignDrafts/{draftId} {
        allow read: if request.auth != null && request.auth.uid == userId;

        // Allow creating — must start as 'draft', publish fields must be null
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.status == 'draft'
          && request.resource.data.publishedCampaignId == null
          && request.resource.data.publishedSlug == null;

        // Allow updating wizard fields, but block server-controlled publish fields
        allow update: if request.auth != null
          && request.auth.uid == userId
          && !request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasAny(['status', 'publishedCampaignId', 'publishedSlug']);
      }

      // ── Notification Center inbox (Phase H.4.3) ───────────────────────────────
      // The owner may READ their own notification feed via the client SDK
      // (real-time onSnapshot). All writes — create, mark-read, mark-all — are
      // performed server-side through API routes with the Admin SDK, which
      // bypasses these rules. Team members read the same feed via those API
      // routes (authorizeAnyWorkspace), since client rules scope reads to the
      // authenticated user's own document tree.
      match /notifications/{notificationId} {
        allow read:  if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
    }

  }
}
